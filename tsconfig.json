{
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "moduleResolution": "node",
    "importHelpers": true,
    "jsx": "react",
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "./dist/.build",
    "declarationDir": "./dist/.build",
    "preserveConstEnums": true,
    "sourceMap": false,
    "removeComments": true,
    "lib": ["es2017", "dom"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "**/*.test.ts"]
}